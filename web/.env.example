# 本机由 npm run setup 自动生成 .env.local；这里仅作服务器配置示例。
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
DATABASE_PATH=/absolute/path/to/blog.sqlite
UPLOADS_PATH=/absolute/path/to/uploads
# 服务器首次初始化可通过环境变量提供 ADMIN_EMAIL / ADMIN_PASSWORD。
# 后续启动不需要保留 ADMIN_PASSWORD。
