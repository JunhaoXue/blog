{
  "name": "junhao-blog",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "setup": "node --import tsx scripts/setup.ts",
    "test": "node --import tsx scripts/integration-test.ts",
    "format": "prettier --write src scripts *.ts *.json",
    "backup": "node --env-file=.env.local --import tsx scripts/backup.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "^4.0.0",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "@types/hast": "3.0.5"
  },
  "type": "module"
}
